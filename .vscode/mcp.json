{
    "inputs": [
        {
            "type": "promptString",
            "id": "clarityApiToken",
            "description": "Microsoft Clarity MCP API token",
            "password": true
        }
    ],
    "servers": {
        "github": {
            "url": "https://api.githubcopilot.com/mcp/",
            "type": "http"
        },
        "Microsoft Clarity": {
            "command": "npx",
            "args": [
                "@microsoft/clarity-mcp-server@latest",
                "${input:clarityApiToken}"
            ],
            "type": "stdio"
        }
    }
}