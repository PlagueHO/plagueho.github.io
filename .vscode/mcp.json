{
    "inputs": [
        {
            "type": "promptString",
            "id": "clarityApiToken",
            "description": "Microsoft Clarity MCP API token",
            "password": true
        }
    ],
    "servers": {
		"context7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp@latest"
			]
		},
        "github": {
            "url": "https://api.githubcopilot.com/mcp/",
            "type": "http"
        },
        "eleventy/source": {
            "type": "sse",
            "url": "https://gitmcp.io/11ty/eleventy"
        },
        "microsoft/clarity": {
            "command": "npx",
            "args": [
                "@microsoft/clarity-mcp-server@latest",
                "${input:clarityApiToken}"
            ],
            "type": "stdio"
        },
        "microsoft/learn": {
            "type": "http",
            "url": "https://learn.microsoft.com/api/mcp"
        },
        "tailwind/source": {
            "type": "sse",
            "url": "https://gitmcp.io/tailwindlabs/tailwindcss"
        }
    }
}