<aside
  class="consent-banner"
  data-consent-banner
  tabindex="-1"
  aria-labelledby="consent-banner-title"
  aria-describedby="consent-banner-description"
  hidden
>
  <div class="consent-banner__content">
    <h2 id="consent-banner-title" class="text-step-1">Help improve this site</h2>
    <p id="consent-banner-description">
      Allow anonymous analytics so I can understand which content is useful. Your choice is optional and can
      be changed at any time.
    </p>
    <div class="consent-banner__actions">
      <button class="button" type="button" data-consent-action="denied" data-ghost-button>No thanks</button>
      <button class="button" type="button" data-consent-action="granted" data-button-variant="primary">
        Allow analytics
      </button>
    </div>
  </div>
</aside>
